# Preferred: Serper (https://serper.dev/) — same style as Sniffy
SERPER_API_KEY=

# Also supported: SerpAPI (https://serpapi.com/)
SERPAPI_KEY=

# When BOTH are set, LeadMine queries both and merges unique Google URLs
# for more crawl targets → more valid leads.

# Optional
# PORT=3002
# ENABLE_SMTP_CHECK=1
