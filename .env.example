# Preferred: Serper (https://serper.dev/) — free tier friendly
SERPER_API_KEY=

# Also supported: SerpAPI (https://serpapi.com/)
SERPAPI_KEY=

# Economy search (default ON): 1 provider, few queries, 1 page → crawl fast, save credits.
# Set SEARCH_ECONOMY=0 only if you want heavier dual search.
SEARCH_ECONOMY=1

# —— Login (required for extractor access) ——
ADMIN_EMAIL=admin@leadmine.com
# Quote the value if it contains $ or other special characters
ADMIN_PASSWORD=

# Optional: separate signing secret for session tokens (defaults to ADMIN_PASSWORD)
# AUTH_SECRET=

# Optional
# PORT=3002
# ENABLE_SMTP_CHECK=1
