# Preferred: Serper (https://serper.dev/)
SERPER_API_KEY=

# Also supported: SerpAPI (https://serpapi.com/)
SERPAPI_KEY=

# When BOTH are set, LeadMine queries both and merges unique Google URLs.

# —— Login (required for extractor access) ——
ADMIN_EMAIL=admin@leadmine.com
# Quote the value if it contains $ or other special characters
ADMIN_PASSWORD=

# Optional: separate signing secret for session tokens (defaults to ADMIN_PASSWORD)
# AUTH_SECRET=

# Optional
# PORT=3002
# ENABLE_SMTP_CHECK=1
