# Preferred: Serper (https://serper.dev/) — free tier friendly
SERPER_API_KEY=

# Also supported: SerpAPI (https://serpapi.com/)
SERPAPI_KEY=

# Economy search (default ON): 1 provider, few queries, 1 page → crawl ASAP.
SEARCH_ECONOMY=1

# —— Login (required for extractor access) ——
ADMIN_EMAIL=admin@leadmine.com
# Quote the value if it contains $ or other special characters
ADMIN_PASSWORD=

# Optional: separate signing secret for session tokens (defaults to ADMIN_PASSWORD)
# AUTH_SECRET=

# —— Split deploy (Vercel frontend + Railway API) ——
# Railway: your Vercel URL(s), comma-separated
# CORS_ORIGIN=https://your-app.vercel.app,http://localhost:5174
#
# Vercel (Project → Environment Variables): public API base, no trailing slash
# VITE_API_URL=https://your-api.up.railway.app

# Optional
# PORT=3002

# Single-email validate endpoint (legacy). Bulk Verify uses free DNS/MX/SMTP.
# ENABLE_SMTP_CHECK=1
