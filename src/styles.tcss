/* LeadMine Extractor — dark-first TUI theme */

Screen {
    background: #0d0d0d;
}

LeadMineApp {
    background: #0d0d0d;
}

#main-layout {
    layout: horizontal;
    height: 1fr;
}

#sidebar {
    width: 22;
    min-width: 22;
    background: #141414;
    border-right: solid #2a2a2a;
    height: 100%;
}

#sidebar-title {
    height: 3;
    content-align: center middle;
    text-style: bold;
    color: #00d4aa;
    border-bottom: solid #2a2a2a;
    padding: 0 1;
}

SidebarNav {
    height: 1fr;
    padding: 1 0;
}

SidebarNav > ListItem {
    padding: 0 1;
    height: 1;
}

SidebarNav > ListItem.--highlight {
    background: #00d4aa22;
    color: #00d4aa;
}

#content-area {
    width: 1fr;
    height: 100%;
}

#status-bar {
    dock: bottom;
    height: 1;
    background: #1a1a1a;
    color: #888888;
    padding: 0 1;
    border-top: solid #2a2a2a;
}

#footer-bar {
    dock: bottom;
    height: 1;
    background: #141414;
    color: #888888;
    padding: 0 1;
    border-top: solid #2a2a2a;
}

ScreenPanel {
    background: #0d0d0d;
    padding: 1 2;
    height: 100%;
}

PanelTitle {
    text-style: bold;
    color: #00d4aa;
    margin-bottom: 1;
    height: 1;
}

FormLabel {
    color: #888888;
    height: 1;
    margin-top: 1;
}

Input, TextArea, Select {
    background: #1a1a1a;
    border: solid #2a2a2a;
    color: #e0e0e0;
    margin-bottom: 0;
}

Input:focus, TextArea:focus, Select:focus {
    border: solid #00d4aa;
}

RadioSet {
    background: transparent;
    border: none;
    height: auto;
    margin: 1 0;
}

RadioButton {
    background: transparent;
    color: #e0e0e0;
    margin-right: 2;
}

RadioButton.-selected {
    color: #00d4aa;
    text-style: bold;
}

#progress-spinner {
    color: #00d4aa;
    height: 1;
    margin-bottom: 1;
}

#progress-count {
    color: #e0e0e0;
    height: 1;
    margin-bottom: 1;
}

#progress-url {
    color: #888888;
    height: 1;
    margin-bottom: 1;
    text-overflow: ellipsis;
}

#log-view {
    height: 1fr;
    border: solid #2a2a2a;
    background: #141414;
    scrollbar-background: #1a1a1a;
    scrollbar-color: #00d4aa;
}

.log-info {
    color: #58a6ff;
}

.log-success {
    color: #3fb950;
}

.log-warning {
    color: #d29922;
}

.log-error {
    color: #f85149;
}

#results-table {
    height: 1fr;
    border: solid #2a2a2a;
    background: #141414;
}

#results-table > .datatable--header {
    background: #1a1a1a;
    color: #00d4aa;
    text-style: bold;
}

#results-table > .datatable--cursor {
    background: #00d4aa22;
}

ExportOption {
    height: 1;
    margin: 0 0 1 0;
}

ExportOption Checkbox {
    background: transparent;
    border: none;
    color: #e0e0e0;
}

HelpSection {
    color: #e0e0e0;
    margin-bottom: 1;
    height: auto;
}

ValidationError {
    color: #f85149;
    height: 1;
    margin-top: 1;
}

Button {
    background: #1a1a1a;
    border: solid #2a2a2a;
    color: #e0e0e0;
    margin-right: 1;
    min-width: 12;
}

Button:hover {
    background: #2a2a2a;
    border: solid #00d4aa;
}

Button.-primary {
    background: #008866;
    border: solid #00d4aa;
    color: #ffffff;
}

Button.-primary:hover {
    background: #00d4aa;
    color: #0d0d0d;
}

#button-row {
    height: auto;
    margin-top: 1;
}

SettingsNote {
    color: #888888;
    height: auto;
    margin-top: 2;
}
